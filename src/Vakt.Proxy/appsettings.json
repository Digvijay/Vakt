{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "openai": {
        "ClusterId": "openai",
        "Match": {
          "Path": "/openai/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/openai/{**catch-all}"
          },
          {
            "RequestHeader": "api-key",
            "Set": "{AzureOpenAI:Key}"
          }
        ]
      }
    },
    "Clusters": {
      "openai": {
        "Destinations": {
          "destination1": {
            "Address": "https://<your-resource>.openai.azure.com/"
          }
        }
      }
    }
  },
  "SemanticCache": {
    "IndexName": "vakt-semantic-cache",
    "SimilarityThreshold": 0.1,
    "EmbeddingDimension": 384,
    "RedisPrefix": "vakt:"
  },
  "Model": {
    "ModelPath": "../models/cpu_and_mobile/cpu-int4-rtn-block-32-acc-level-4",
    "ModelDownloadUrl": "https://huggingface.co/microsoft/Phi-3-mini-4k-instruct-onnx/resolve/main/cpu_and_mobile/cpu-int4-rtn-block-32-acc-level-4"
  }
}